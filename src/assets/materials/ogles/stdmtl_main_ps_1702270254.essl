{
    highp vec4 _48 = texture2D(s_DiffuseSampler, varying_TEXCOORD0.xy);
    highp vec4 _69 = texture2D(s_EmissiveSampler, varying_TEXCOORD0.xy * g_fUVMul) * g_ftime;
    highp vec3 _72 = (mix(varying_COLOR0.xyz, vec3(1.0), vec3(texture2D(s_AlphaDISampler, varying_TEXCOORD0.xy).x)).xyz * _48.xyz).xyz + _69.xyz;
    highp vec4 _78 = vec4(_72.x, _72.y, _72.z, _48.w);
    _78.w = dot(_72.xyz, vec3(0.2989999949932098388671875, 0.58700001239776611328125, 0.114000000059604644775390625)) * _69.w;
