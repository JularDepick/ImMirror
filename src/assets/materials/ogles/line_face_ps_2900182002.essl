//ver200 es line_face
precision mediump float;
precision highp int;

uniform highp sampler2D s_AlphaDISampler;

varying highp vec4 in_var_POSITION;
varying highp vec4 varying_COLOR0;
varying highp vec2 varying_TEXCOORD0;

void main()
{
    if ((texture2D(s_AlphaDISampler, varying_TEXCOORD0).x - 0.5) < 0.0)
    {
        discard;
    }
    highp vec4 _39 = vec4(varying_COLOR0.x, varying_COLOR0.y, varying_COLOR0.z, vec4(1.0).w);
    _39.w = 0.0;
    gl_FragColor = _39;
}

