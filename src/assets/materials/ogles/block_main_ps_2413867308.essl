//ver200 es block_Main
precision mediump float;
precision highp int;

varying highp vec4 in_var_POSITION;
varying highp vec4 varying_COLOR0;
varying highp vec2 in_var_TEXCOORD0;

void main()
{
    highp vec4 _20 = vec4(varying_COLOR0.x, varying_COLOR0.y, varying_COLOR0.z, vec4(1.0).w);
    _20.w = 0.0;
    gl_FragColor = _20;
}

