varying highp vec4 varying_TEXCOORD0;

void main()
{
    highp vec4 _48 = texture2D(s_DiffuseSampler, varying_TEXCOORD0.xy);
    highp vec4 _62 = texture2D(s_EmissiveSampler, varying_TEXCOORD0.xy * g_fUVMul) * g_ftime;
    highp vec3 _65 = (clamp(varying_COLOR0, vec4(0.0), vec4(1.0)).xyz * _48.xyz).xyz + _62.xyz;
    highp vec4 _71 = vec4(_65.x, _65.y, _65.z, _48.w);
    _71.w = dot(_65.xyz, vec3(0.2989999949932098388671875, 0.58700001239776611328125, 0.114000000059604644775390625)) * _62.w;
    gl_FragColor = _71;
}

