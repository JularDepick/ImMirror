//ver200 es line_face
precision mediump float;
precision highp int;

uniform highp sampler2D s_DiffuseSampler;
uniform highp sampler2D s_AlphaDISampler;

varying highp vec4 in_var_POSITION;
varying highp vec4 varying_COLOR0;
varying highp vec2 varying_TEXCOORD0;

void main()
{
    highp vec4 _33 = texture2D(s_DiffuseSampler, varying_TEXCOORD0);
    if ((texture2D(s_AlphaDISampler, varying_TEXCOORD0).x - 0.5) < 0.0)
    {
        discard;
    }
    highp vec3 _45 = _33.xyz * varying_COLOR0.xyz;
    highp vec4 _47 = vec4(_45.x, _45.y, _45.z, _33.w);
    _47.w = 0.0;
    gl_FragColor = _47;
}

