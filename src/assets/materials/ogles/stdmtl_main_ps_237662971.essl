void main()
{
    highp vec4 _53 = texture2D(s_DiffuseSampler, varying_TEXCOORD0.xy);
    highp vec4 _71 = texture2D(s_EmissiveSampler, varying_TEXCOORD0.xy * g_fUVMul) * g_ftime;
    highp vec3 _74 = ((clamp(varying_COLOR0, vec4(0.0), vec4(1.0)).xyz * _53.xyz).xyz + g_OverlayColor).xyz + _71.xyz;
    highp vec4 _80 = vec4(_74.x, _74.y, _74.z, _53.w);
    _80.w = dot(_74.xyz, vec3(0.2989999949932098388671875, 0.58700001239776611328125, 0.114000000059604644775390625)) * _71.w;
    gl_FragColor = _80;
