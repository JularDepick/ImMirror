    highp vec3 _88 = (mix(varying_COLOR0.xyz, vec3(1.0), vec3(texture2D(s_AlphaDISampler, varying_TEXCOORD0.xy).x)).xyz * mix(_52.xyz, _61.xyz * g_MaskColor, vec3(_61.w)).xyz).xyz + _85.xyz;
    highp vec4 _94 = vec4(_88.x, _88.y, _88.z, _52.w);
