<?xml version="1.0" encoding="utf-8" standalone="yes" ?>
<Ui>
	<Script file="ui/mobile/mvc/developer/modeSet/DeveloperModeSetModel.lua"/>
	<Script file="ui/mobile/mvc/developer/modeSet/DeveloperModeSetView.lua"/>
	<Script file="ui/mobile/mvc/developer/modeSet/DeveloperModeSetCtrl.lua"/>

	##左侧按钮
	<Button name="DeveloperModeSetTabBtnTemplate" virtual="true" abs_x="175" abs_y="60">
		<Layers>
			<Layer level="overlay">
				<Texture name="$parentChecked" inherits="TemplateTabFullpageH" />
				<FontString name="$parentName" fonttype="BlackFont26" justifyH="center" text="tab按钮" abs_x="175" abs_y="27">
					<Color r="255" g="153" b="63"/>
					<Anchors>
						<Anchor point="center" relativePoint="center" relativeTo="$parent" />
					</Anchors>
				</FontString>
				##LLDO:红点
				<Texture name="$parentRedTag" file="ui/mobile/texture2/common.xml" uvname="img_dot_tips" hidden="true" abs_x="20" abs_y="20">
					<Anchors>
						<Anchor point="center" relativePoint="topright" relativeTo="$parent">
							<Offset>
								<AbsDimension x="-2" y="-3"/>
							</Offset>
						</Anchor>
					</Anchors>
				</Texture>
                <Texture name="$parentSighTag" file="ui/mobile/texture2/common.xml" uvname="icon_tipoff_o" hidden="true" abs_x="10" abs_y="25">
					<Angle value="37" />
					<Anchors>
						<Anchor point="center" relativePoint="topright" relativeTo="$parent">
							<Offset>
								<AbsDimension x="-2" y="-3"/>
							</Offset>
						</Anchor>
					</Anchors>	
				</Texture>
			</Layer>
		</Layers>
		<NormalTexture name="$parentNormal" file="ui/mobile/texture2/common.xml" uvname="tab_fullpage_left_n.png"/>
		<PushedTexture name="$parentPushedBG" file="ui/mobile/texture2/common.xml" uvname="tab_fullpage_left_n.png" rel_x="0.9" rel_y="0.9">
			<Anchors>
				<Anchor point="left" relativePoint="left" relativeTo="$parent" />
			</Anchors>
		</PushedTexture>
		<Scripts>
			<OnClick>GetInst("UIManager"):GetCtrl("DeveloperModeSet"):TabBtnClicked();</OnClick>
		</Scripts>
	</Button>


	<Frame name="DeveloperModeSet" parent="UIClient"  frameStrata="MEDIUM" hidden="true" framelevel="3000">
		<Size>
			<RelDimension x="1.0" y="1.0"/>
		</Size> 
		<Anchors>
			<Anchor point="topleft" relativePoint="topleft" relativeTo="$parent">
				<Offset>
					<AbsDimension x="0" y="0" />
				</Offset>
			</Anchor>
		</Anchors>
		<Layers>
			<Layer level="BACKGROUND">
				<Texture name="$parentBkg" inherits="TemplateBigBkg2" rel_x="1.05" rel_y="1.05" >
					<Anchors>
						<Anchor point="center" relativePoint="center" relativeTo="$parent" />
					</Anchors>	
				</Texture>					
				<Texture name="$parentTabsBkg" inherits="TemplateBigBkg3" abs_x="175" rel_y ="1">
					<Anchors>
						<Anchor point="topleft" relativePoint="topleft" relativeTo="$parent" />
					</Anchors>	
				</Texture>
			</Layer>
		</Layers>
		<Frames>
			##标题栏
			<Frame name = "$parentTitle" inherits ="TemplateTopTitleBkg0" rel_x="1" abs_y ="61">
				<Anchors>
					<Anchor point="topleft" relativePoint="topleft" relativeTo="$parent">
						<Offset>
							<AbsDimension x="0" y="0" />
						</Offset>
					</Anchor>
				</Anchors>
				<Layers>
					<Layer level="BACKGROUND">
						##标题名
						<FontString name="$parentName" fonttype="BlackFont30" justifyH="left" justifyV="middle" text="$13000" abs_x="260" abs_y="50">
							<Color r="255" g="135" b="27"/>
							<Anchors>
								<Anchor point="left" relativePoint="left" relativeTo="$parent">
									<Offset>
										<AbsDimension x="37" y="0"/>
									</Offset>
								</Anchor>
							</Anchors>
						</FontString>
					</Layer>
				</Layers>
			</Frame>
			##关闭按钮
			<Frame name="$parentCloseBtn" inherits="TemplateCloseBtnLarge">
				<Anchors>
					<Anchor point="right" relativePoint="right" relativeTo="$parentTitle">
						<Offset>
							<AbsDimension x="0" y="0"/>
						</Offset>
					</Anchor>
				</Anchors>
				<Scripts>
					<OnClick>GetInst("UIManager"):GetCtrl("DeveloperModeSet"):CloseBtnOnClicked();</OnClick>
				</Scripts>
			</Frame>
			##左侧页签
            <Frame name="$parentTabs" abs_x="175" abs_y = "500" >
                <Anchors>
                    <Anchor point="topleft" relativePoint="topleft" relativeTo="$parentTabsBkg">
                        <Offset>
                            <AbsDimension x="0" y="78"/>
                        </Offset>
                    </Anchor>
                </Anchors>
            </Frame>		
			##跳至开发者学院wiki按钮	
			<Button name ="$parentCreatorWiki" abs_x ="159" abs_y ="30">
				<Anchors>
					<Anchor point="bottom" relativePoint="bottom" relativeTo="$parentTabsBkg">
						<Offset>
							<AbsDimension x="0" y="-38" />
						</Offset>
					</Anchor>
				</Anchors>
				<Layers>
					<Layer level= "overlay">
						<Texture name="$parentIcon" file="ui/mobile/texture0/common_icon.xml" uvname="icon_developbook" abs_x="28" abs_y ="32">
							<Anchors>
								<Anchor point="topleft" relativePoint="topleft" relativeTo="$parent" />
							</Anchors>	
						</Texture>					
					</Layer>
				</Layers>
				<Frames>		
					<RichText name="$parentRich" lineInterval="1" input_transparent="true" fonttype="BlackFont24" justifyV="bottom" justifyH="left" text="XXX" abs_x="150" abs_y="25">
						<LinkColor r="61" g="69" b="70"/>
						<ShadowColor r="61" g="69" b="70"/>
						<Anchors>
							<Anchor point="left" relativePoint="left" relativeTo="$parent">
								<Offset>
									<AbsDimension x="38" y="0"/>
								</Offset>
							</Anchor>
						</Anchors>
						<Scripts>
							<OnClick>GetInst("UIManager"):GetCtrl("DeveloperModeSet"):OpenCreatorWiki();</OnClick>
						</Scripts>
					</RichText> 
				</Frames>
			</Button>
		</Frames>
	</Frame>
</Ui>
