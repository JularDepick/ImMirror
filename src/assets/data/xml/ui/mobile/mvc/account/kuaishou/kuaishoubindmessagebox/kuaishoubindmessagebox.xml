<?xml version="1.0" encoding="utf-8" standalone="yes" ?>
<Ui>
	<Script file="ui/mobile/mvc/account/KuaiShou/KuaiShouBindMessageBox/KuaiShouBindMessageBoxModel.lua"/>
	<Script file="ui/mobile/mvc/account/KuaiShou/KuaiShouBindMessageBox/KuaiShouBindMessageBoxView.lua"/>
	<Script file="ui/mobile/mvc/account/KuaiShou/KuaiShouBindMessageBox/KuaiShouBindMessageBoxCtrl.lua"/>

	<Frame name="KuaiShouBindMessageBox" parent="UIClient" frameStrata="HIGH" hidden="true" framelevel="1000" input_transparent="false">
		<Size>
			<RelDimension x="1.0" y="1.0"/>
		</Size>
		<Anchors>
			<Anchor point="center" relativePoint="center" relativeTo="$parent">
				<Offset>
					<AbsDimension x="0" y="0"/>
				</Offset>
			</Anchor>
		</Anchors>
		<Layers>
			<Layer level="BACKGROUND">
				<Texture name="$parentBkg" file="ui/white.png" stretchedge="true" color="40000000"/>
				<Texture name="$parentChenDi" inherits="TemplateBkg1" abs_x="653" abs_y="498">
					<Anchors>
						<Anchor point="center" relativePoint="center" relativeTo="$parent">
							<Offset>
								<AbsDimension x="0" y="0"/>
							</Offset>
						</Anchor>
					</Anchors>
				</Texture>
				<Texture name="$parentLogo" file="ui/mobile/texture0/bigtex/img_adv_kuaishou.png" abs_x="540" abs_y="205">
					<Anchors>
						<Anchor point="top" relativePoint="top" relativeTo="$parentChenDi">
							<Offset>
								<AbsDimension x="0" y="78"/>
							</Offset>
						</Anchor>
					</Anchors>
				</Texture>
			</Layer>
		</Layers>
		<Frames>
			<Frame name="$parentTitle" inherits="TemplateTopTitleBkgWithHuaWen0" abs_x="640" abs_y="65">
				<Anchors>
					<Anchor point="top" relativeTo="$parentChenDi" relativePoint="top">
						<Offset>
							<AbsDimension x="-4" y="0"/>
						</Offset>
					</Anchor>
				</Anchors>
				<Layers>
					<Layer>
						##标题名
						<FontString name="$parentName" fonttype="BlackFont30" justifyH="center" text="$35394" rel_x="1" abs_y="30">
							<Color r="77" g="112" b="116"/>
							<Anchors>
								<Anchor point="center" relativePoint="center" relativeTo="$parent" />
							</Anchors>
						</FontString>
					</Layer>
				</Layers>
			</Frame>
			<Button name="$parentCloseBtn" inherits="TemplateCloseBtn">
				<Anchors>
					<Anchor point="topright" relativePoint="topright" relativeTo="$parentChenDi">
						<Offset>
							<AbsDimension x="-20" y="6"/>
						</Offset>
					</Anchor>
				</Anchors>
				<Scripts>
					<OnClick>GetInst("UIManager"):GetCtrl("KuaiShouBindMessageBox"):CloseBtnClicked();</OnClick>
				</Scripts>
			</Button>
			<RichText name="$parentDesc" lineInterval="2" multiLine="false" fonttype="BlackFont24" autoextend="true" abs_x="507" abs_y="118">
				<Anchors>
					<Anchor point="top" relativeTo="$parentLogo" relativePoint="bottom">
						<Offset>
							<AbsDimension x="0" y="10" />
						</Offset>
					</Anchor>
				</Anchors>
			</RichText>
			<Button name="$parentCenterBtn" inherits="TemplateBtn3">
				<Anchors>
					<Anchor point="bottom" relativeTo="$parentChenDi" relativePoint="bottom">
						<Offset>
							<AbsDimension x="0" y="-26"/>
						</Offset>
					</Anchor>
				</Anchors>
				<Layers>
					<Layer level="overlay">
						<FontString name="$parentName" fonttype="BlackFont24" justifyH="center" abs_x="180" abs_y="26" text="$35396">
							<Color r="55" g="54" b="51"/>
							<Anchors>
								<Anchor point="center" relativePoint="center" relativeTo="$parent">
									<Offset>
										<AbsDimension x="0" y="0"/>
									</Offset>
								</Anchor>
							</Anchors>
						</FontString>
					</Layer>
				</Layers>
				<Scripts>
					<OnClick>GetInst("UIManager"):GetCtrl("KuaiShouBindMessageBox"):CenterBtnClick()</OnClick>
				</Scripts>
			</Button>
		</Frames>
	</Frame>
</Ui>
