<MaterialTemplate>
	<GlobalKeyWordCfg desc="global keyword">

		<!-- 定义要和游戏内的代码对齐 -->
        <Keyword name="NOT---USED" key="0"/>
		
		<Keyword  name="ATI_NV"  key="1"/>
		<Keyword  name="FOG_DISTANCE"  key="2" />
		<Keyword  name="FOG_HEIGHT"  key="3" />
		<Keyword  name="LOG_SHADOWMAP"  key="4" />
		<Keyword name="ALPHA_TEST"  key="5"	/>
        <Keyword name="OPEN_G_DIR_LIGHT" key="6" />
        
		<FeatureGroup name="MASK_TEXTURE" group="1" >
            <Keyword name="MASK_TEXTURE_1" key="7" />
		    <Keyword name="MASK_TEXTURE_2" key="8" />
        </FeatureGroup>

        <FeatureGroup name="SELFILLUM" group="2" >
            <Keyword name="SELFILLUM_COLOR" key="9"/>
			<Keyword name="SELFILLUM_TEX" key="10"/>
            <Keyword name="SELFILLUM_ALL" key="11"/>
            <Keyword name="SELFILLUM_ALPHA" key="17" />
        </FeatureGroup>

        <FeatureGroup name="OVERLAY_MODE" group="3" >
            <Keyword name="OVERLAY_MODE_COLOR" key="12" />
            <Keyword name="OVERLAY_MODE_TEX" key="13" />
            <Keyword name="OVERLAY_MODE_ALL" key="14"/>
        </FeatureGroup>
		

		<FeatureGroup name="USE_TEXTURE"  group="4">
			<Keyword name="USE_TEXTURE_1" key="15" />
			<Keyword name="USE_TEXTURE_2" key="16"/>
		</FeatureGroup>
		
		<!-- 17-20空出来了 -->
		<FeatureGroup name="SKIN_MAXINFL"  group="5">
			<Keyword name="SKIN_MAXINFL_X" key="37" />
			<Keyword name="SKIN_MAXINFL_XY" key="38" />
			<Keyword name="SKIN_MAXINFL_XYZ" key="39"/>
			<Keyword name="SKIN_MAXINFL_XYZW" key="40"/>
			<Keyword name="SKIN_MAXINFL_STATIC" key="41"/>
		</FeatureGroup>
		

		<Keyword name="BLEND_VERTCOLOR" key="21" />
		<Keyword name="DIFFUSE_TEX" key="22" />

			
		<FeatureGroup name="RGB_MOD" group="6">
            <Keyword name="RGB_MOD_GRAY" key="23" />
            <Keyword name="RGB_MOD_COLOR" key="24"/>
        </FeatureGroup>
		
		<Keyword name="EMISSIVE" key="25"/>
		<Keyword name="ALPHATEX_DI" key="26" />
		<Keyword name="LIGHT_SHADOW" key="27" />
		<Keyword name="ALPHA_BLEND" key="28" />
        <Keyword name="RECEIVE_LIGHTING" key="29" />
        <Keyword name="TRANSFORM_XYZ" key="30" />
        <Keyword name="USE_CUSTOM_MODEL" key="31" />

        <FeatureGroup name="MODEL_TRANSPARENT" group="7">
            <Keyword name="MODEL_TRANSPARENT_ALPHA" key="32" />
            <Keyword name="MODEL_TRANSPARENT_RGB" key="33" />
		</FeatureGroup>
		
		<Keyword name="PARTICLE_MASK_TEXTURE" key="35"/> 
		<Keyword name="ALPHA_FOR_BLOOM" key="36"  />
		<Keyword name="USE_RIM_COLOR" key="42"  />
	</GlobalKeyWordCfg>
    
	<MaterialCfg desc="material config">
		<Material name="triangle">
			<Technique name="lod0" usage="135" lod="0" shader="triangle_Main"/>
		</Material>

		<Material name="skyplane">
			<Technique name="lod0" usage="135" lod="0" shader="skyplane_Main">
				<State name="CullMode" value="CullOff"/>
				<State name="ZTest" value="true" depthFunc="LEqual"/>
				<State name="ZWrite" value="false"/>
				<State name="BlendType" value="OPAQUE"/>
				<State name="ColorMask" value="RGB"/>
			</Technique>
			<Params>
				<var name="g_SkyHeight" type="float"/>
				<var name="g_DayTime" type="float"/>
				<var name="g_SunDirect" type="float3"/>
				<var name="g_SunColor" type="float4"/>
				<var name="g_SkyModColor" type="float4"/>
				<var name="g_SkyTex" type="texture"/>
				<var name="g_StarTex" type="texture"/>
			</Params>
			<Samplers>
				<sampler name="s_SkySampler" texture="g_SkyTex"  addressU="wrap" addressV="clamp" minFilter="linear" magFilter="linear" mipFilter="point"/>
				<sampler name="s_StarSampler" texture="g_StarTex"/>
			</Samplers>
		</Material>

		<Material name="cloudplane">
			<Technique name="lod0" usage="135" lod="0"  shader="cloudplane_Main">
				<State name="CullMode" value="CullOff"/>
				<State name="ZTest" value="true" depthFunc="LEqual"/>
				<State name="ZWrite" value="false"/>
				<State name="BlendType" value="ALPHABLEND"/>
				<State name="ColorMask" value="RGB"/>
			</Technique>
			<Params>
				<var name="g_SkyModColor" type="float4"/>
				<var name="g_CloudTex" type="texture"/>
				<var name="g_CloudLightTex" type="texture"/>
			</Params>
			<Samplers>
				<sampler name="s_CloudSampler" texture="g_CloudTex"/>
				<sampler name="s_CloudLightSampler" texture="g_CloudLightTex"/>
			</Samplers>
		</Material>

		<Material name="sun">
			<Technique name="lod0" usage="135" lod="0" shader="sun_Main">
				<State name="CullMode" value="CullOff"/>
				<State name="ZTest" value="true" depthFunc="LEqual"/>
				<State name="ZWrite" value="false"/>
				<State name="BlendType" value="ADD"/>
				<State name="ColorMask" value="RGB"/>
			</Technique>
			<Params>
				<var name="g_SunTex" type="texture"/>
				<var name="g_SunColor" type="float4"/>
			</Params>
			<Samplers>
				<sampler name="s_SunSampler" texture="g_SunTex" addressU="clamp" addressV="clamp"/>
			</Samplers>
		</Material>


		<Material name="blockitem">
			<Technique name="opaque" usage="135" lod="0" shader="blockitem_Main" fallback="blockitem_Main_fallback">
				<State  name="CullMode"  value="CullBack"/>
				<State  name="ZWrite"  value="true"/>
				<State  name="ZTest"  value="true"/>
				<State  name="BlendType"  value="OPAQUE"/>
			</Technique>
			<Technique name="alphaBlend" usage="135" lod="0" shader="blockitem_Main" fallback="blockitem_Main_fallback">
				<State  name="BlendType"  value="ALPHABLEND"/>
				<State  name="TranspantFlag"  value="2"/>
			</Technique>
			<Technique name="grass" usage="135" lod="0" shader="blockitem_Main" fallback="blockitem_Main_fallback">
				<State  name="CullMode"  value="CullBack"/>
				<State  name="ZWrite"  value="true"/>
				<State  name="ZTest"  value="true"/>
				<State  name="BlendType"  value="OPAQUE"/>
				<State  name="AlphaTest"  value="true"/>
			</Technique>
			<Technique name="tree" usage="135" lod="0" shader="blockitem_Main" fallback="blockitem_Main_fallback">
				<State  name="CullMode"  value="CullOff"/>
				<State  name="ZWrite"  value="true"/>
				<State  name="ZTest"  value="true"/>
				<State  name="BlendType"  value="OPAQUE"/>
				<State  name="AlphaTest"  value="true"/>
			</Technique>
			<Technique name="xparent" usage="135" lod="0" shader="blockitem_Main" fallback="blockitem_Main_fallback">
				<State  name="CullMode"  value="CullBack"/>
				<State  name="ZWrite"  value="false"/>
				<State  name="ZTest"  value="true"/>
				<State  name="BlendType"  value="ALPHABLEND"/>
				<State  name="TranspantFlag"  value="1"/>
			</Technique>
			<Technique name="light" usage="135" lod="0" shader="blockitem_Main" fallback="blockitem_Main_fallback">
				<State  name="CullMode"  value="CullOff"/>
				<State  name="ZWrite"  value="true"/>
				<State  name="ZTest"  value="true"/>
				<State  name="BlendType"  value="ADD"/>
				<State  name="TranspantFlag"  value="1"/>
			</Technique>
			<Technique name="shadowgen" usage="8" lod="0" shader="blockitem_ShadowGen">
				
			</Technique>
			<Params>
				<var name="g_DiffuseTex" type="texture"/>
				<var name="LightDir" type="float3"/>
				<var name="GrassColor" type="float3"/>
				<var name="g_OverlayColor" type="float3"/>
				<var name="g_UVTranslate" type="float2"/>
				<var name="g_EmissiveTex" type="texture"/>
                                 <var name="g_fUVMul" type="float" default="1.0"/>
				<var name="g_ftime" type="float"/>
			</Params>
			<Samplers>
				<sampler name="s_DiffuseSampler" texture="g_DiffuseTex" addressU="wrap" addressV="warp" minFilter="linear" magFilter="linear" mipFilter="point"  minFilter1="point" magFilter1="point" mipFilter1="point"/>
				<sampler name="s_EmissiveSampler" texture="g_EmissiveTex" addressU="wrap" addressV="wrap" minFilter="linear" magFilter="linear" mipFilter="none"/>
			</Samplers>
		</Material>


		<Material name="blockdecal">
			
			<Technique name="default" usage="135" lod="0" shader="blockdecal_Main">
				<State  name="CullMode"  value="CullOff"/>
				<State  name="ZWrite"  value="false"/>
				<State  name="ZTest"  value="true" depthFunc="Equal"/>
				<State  name="BlendType"  value="MODULATE2X"/>
				<State  name="TranspantFlag"  value="3"/>
			</Technique>
			 <Technique name="shadow" usage="135" lod="0" shader="blockdecal_Main">
				<State  name="CullMode"  value="CullOff"/>
				<State  name="ZWrite"  value="false"/>
				<State  name="ZTest"  value="true" depthFunc="LEqual"/>
				<State  name="BlendType"  value="MODULATE2X"/>
				<State  name="TranspantFlag"  value="3"/>
			</Technique>
			<Params>
				<var name="g_DiffuseTex" type="texture"/>
			</Params>
			<Samplers>
				<sampler name="s_DiffuseSampler" texture="g_DiffuseTex" addressU="clamp" addressV="clamp" minFilter="point" magFilter="point" mipFilter="point"/>
			</Samplers>
		</Material>

		
		<Material name="block">
		   <Technique name="default" usage="135" lod="0" shader="block_Main" fallback="block_Main_fallback">
				<State  name="CullMode"  value="CullBack"/>
				<State  name="ZWrite"  value="true"/>
				<State  name="BlendType"  value="OPAQUE"/>
				<Keyword name="ALPHA_FOR_BLOOM" />
			</Technique>
			 <Technique name="grass" usage="135" lod="0" shader="block_Main" fallback="block_Main_fallback">
				<State  name="CullMode"  value="CullOff"/>
				<State  name="ZWrite"  value="true"/>
				<State  name="ZTest"  value="true"/>
				<State  name="BlendType"  value="OPAQUE"/>
				<State  name="AlphaTest"  value="true"/>
				<Keyword name="ALPHA_FOR_BLOOM" />
			</Technique>
			<Technique name="tree" usage="135" lod="0" shader="block_Main" fallback="block_Main_fallback">
				<State  name="CullMode"  value="CullOff"/>
				<State  name="ZWrite"  value="true"/>
				<State  name="ZTest"  value="true"/>
				<State  name="BlendType"  value="OPAQUE"/>
				<State  name="AlphaTest"  value="true"/>
				<Keyword name="ALPHA_FOR_BLOOM" />
			</Technique>
			<Technique name="xparent" usage="135" lod="0" shader="block_Main" fallback="block_Main_fallback">
				<State  name="CullMode"  value="CullBack"/>
				<State  name="ZWrite"  value="false"/>
				<State  name="ZTest"  value="true"/>
				<State  name="BlendType"  value="ALPHABLEND"/>
				<State  name="TranspantFlag"  value="1"/>
				<State name="ColorMask" value="RGB"/>
			</Technique>
			<Technique name="light" usage="135" lod="0" shader="block_Main" fallback="block_Main_fallback">
				<State  name="CullMode"  value="CullOff"/>
				<State  name="ZWrite"  value="true"/>
				<State  name="ZTest"  value="true"/>
				<State  name="BlendType"  value="ADD"/>
				<State  name="TranspantFlag"  value="1"/>
				<State name="ColorMask" value="RGB"/>
			</Technique>
			<!-- 编辑模式下，工具框的的连线 -->
			<Technique name="curveFace" usage="135" lod="0" shader="block_Main" fallback="block_Main_fallback" desc="在游戏的CurveScreenRender中使用，很不标准">
				<State  name="CullMode"  value="CullOff"/>
				<State  name="ZWrite"  value="true"/>
				<State  name="ZTest"  value="true"/>
				<State  name="TranspantFlag"  value="1"/>
				<State name="ColorMask" value="RGB"/>
			</Technique>
			<Technique name="shadowgen" usage="8" lod="0" shader="block_ShadowGen" >
				
			</Technique>
			<Params>
				<Keyword name="DIFFUSE_TEX"  value="1"/>
				<var name="g_DiffuseTex" type="texture"/>
				<var name="g_AlphaTexDI" type="texture"/>
				<var name="g_OverlayTex" type="texture"/>
				<var name="g_EmissiveTex" type="texture"/>
				<var name="g_fUVMul" type="float" default="1.0"/>
				<var name="g_ftime" type="float"/>
				<var name="g_vSaturation" type="float3"/>
				<var name="g_vColorScale" type="float3"/>
			</Params>
			<Samplers>
				<sampler name="s_DiffuseSampler" texture="g_DiffuseTex" addressU="wrap" addressV="wrap" minFilter="point" magFilter="point" mipFilter="point"/>
				<sampler name="s_AlphaDISampler" texture="g_AlphaTexDI" addressU="wrap" addressV="wrap" minFilter="point" magFilter="point" mipFilter="point"/>
				<sampler name="s_EmissiveSampler" texture="g_EmissiveTex" addressU="wrap" addressV="wrap" minFilter="linear" magFilter="linear" mipFilter="none"/>
				<sampler name="s_OverlaySampler" texture="g_OverlayTex" addressU="clamp" addressV="clamp"/>
				<sampler name="s_DepthMapSampler" texture="g_depthtexture" addressU="clamp" addressV="clamp" minFilter="linear" magFilter="linear" mipFilter="none"/>
			</Samplers>
		</Material>
	   <!-- 开启反射的时候的水 -->
		<Material name="block_water">
			<Technique name="default" usage="135" lod="0" shader="block_water">
				<State  name="CullMode"  value="CullBack"/>
				<State  name="ZWrite"  value="false"/>
				<State  name="ZTest"  value="true"/>
				<State  name="BlendType"  value="ALPHABLEND"/>
				<State  name="TranspantFlag" value="1" />
				<State name="ColorMask" value="RGB"/>
			</Technique>
			<Params>
				<var name="g_DiffuseTex" type="texture"/>
				<var name="g_NormalTex" type="texture"/>
				<var name="g_ReflectTex" type="texture"/>
				<var name="g_NumTexRepeat" type="float" default="8.0"/>
				<var name="g_fSpeed" type="float" default="0.2"/>
				<var name="g_fAmp" type="float" default="3.0"/>
			</Params>
			<Samplers>
				<sampler name="s_DiffuseSampler" texture="g_DiffuseTex" addressU="clamp" addressV="clamp"/>
				<sampler name="NormalSampler" texture="g_NormalTex" addressU="wrap" addressV="wrap"/>
				<sampler name="ReflectSampler" texture="g_ReflectTex" addressU="clamp" addressV="clamp"/>
			</Samplers>
		</Material>
		<!-- 电流线路 -->
		<Material name="block_uvanim">
			<Technique name="default" usage="135" lod="0" shader="block_uvanim_Main"  desc="电路的线">
				<State  name="CullMode"  value="CullBack"/>
				<State  name="ZWrite"  value="false"/>
				<State  name="ZTest"  value="true"/>
				<State  name="TranspantFlag"  value="1"/>
			</Technique>

			<Technique name="alphaBlend" usage="135" lod="0" shader="block_uvanim_Main">
				<State  name="CullMode"  value="CullOff"/>
				<State  name="ZWrite"  value="false"/>
				<State  name="ZTest"  value="true"/>
				<State  name="BlendType"  value="ALPHABLEND"/>
				<State  name="TranspantFlag"  value="1"/>
			</Technique>

			<Technique name="shadowgen" usage="8" lod="0" shader="block_uvanim_ShadowGen">
			</Technique>
			<Params>
				<var name="g_DiffuseTex" type="texture"/>
				<var name="g_UVTranslate" type="float2"/>
			</Params>
			<Samplers>
				<sampler name="s_DiffuseSampler" texture="g_DiffuseTex" addressU="wrap" addressV="wrap"/>
			</Samplers>
		</Material>
		<!-- 角色-->
		<Material name="stdmtl">
			<Technique name="opaque" usage="135" lod="0" shader="stdmtl_Main" fallback="stdmtl_Main_fallback">
				<State  name="ZWrite"  value="true"/>
				<State  name="ZTest"  value="true"/>
				<State  name="CullMode"  value="CullBack"/>
				<State  name="BlendType"  value="OPAQUE"/>
				
			</Technique>

			<Technique name="alphaTest" usage="135" lod="0" shader="stdmtl_Main" fallback="stdmtl_Main_fallback">
				<State  name="ZWrite"  value="true"/>
				<State  name="ZTest"  value="true"/>
				<State  name="CullMode"  value="CullBack"/>
				<State  name="BlendType"  value="OPAQUE"/>
				<State  name="AlphaTest"  value="true"/>
				<State name="ColorMask" value="RGB"/>
			</Technique>

			<Technique name="blend" usage="135" lod="0" shader="stdmtl_Main" fallback="stdmtl_Main_fallback">
				<State  name="ZWrite"  value="false"/>
				<State  name="ZTest"  value="true"/>
				<State  name="CullMode"  value="CullOff"/>
				<State  name="BlendType"  value="ALPHABLEND"/>
				<State  name="TranspantFlag"  value="2"/>
				<State name="ColorMask" value="RGB"/>
			</Technique>

			<Technique name="shadowgen" usage="8" lod="0" shader="stdmtl_ShadowGen">
				
			</Technique>
			<Params>
				<var name="g_DiffuseTex" type="texture"/>
				<var name="g_AlphaTexDI" type="texture"/>
				<var name="g_SpecSelfTex" type="texture"/>
				<var name="g_OverlayTex" type="texture"/>
				<var name="g_MaskColor" type="float3"/>
				<var name="g_OverlayColor" type="float3"/>
				<var name="g_SpecPower" type="float" default="0.0f"/>
				<var name="g_SpecShiness" type="float" default="0.0f"/>
				<var name="g_SelfPower" type="float3" default="0.0f,0.0f,0.0f"/>
				<var name="g_RimColor" type="float4" default="1.0f,1.0f,0.0f,1.0f"/>
				<var name="g_RimPower" type="float" default="10.0f" />
				<var name="g_TransU" type="float" default="0.0f"/>
				<var name="g_TransV" type="float" default="0.0f"/>
				<var name="g_ScaleU" type="float" default="1.0f"/>
				<var name="g_ScaleV" type="float" default="1.0f"/>
				<var name="g_RotUV" type="float" default="0.0f"/>
				<var name="g_EmissiveTex" type="texture"/>
				<var name="g_fUVMul" type="float"/>
				<var name="g_ftime" type="float"/>
				<var name="g_ModelTransparent" type="float" default="1.0f"/>
			</Params>
			<Samplers>
				<sampler name="s_DiffuseSampler" texture="g_DiffuseTex"/>
				<sampler name="s_EmissiveSampler" texture="g_EmissiveTex" addressU="wrap" addressV="wrap" minFilter="linear" magFilter="linear" mipFilter="none"/>
				<sampler name="s_AlphaDISampler" texture="g_AlphaTexDI"/>
				<sampler name="s_DepthMapSampler" texture="g_depthtexture" addressU="clamp" addressV="clamp" minFilter="linear" magFilter="linear" mipFilter="none"/>
				<sampler name="s_SpecSelfSampler" texture="g_SpecSelfTex"/>
				<sampler name="s_OverlaySampler" texture="g_OverlayTex"/>
			</Samplers>
		</Material>




		<Material name="uvanim">
			<Technique name="blend" usage="135" lod="0" shader="uvanim_Main">
				<State name="BlendType" value="OPAQUE"/>
			</Technique>

			<Technique name="selfillum" usage="135" lod="0" shader="uvanim_Main">
				<State name="BlendType" value="ALPHABLEND"/>
			</Technique>

			<Params>
				<Keyword name="RECEIVE_FOG"  value="1"/>
				<Keyword name="USE_MASK_TEX"  value="1"/>
				<var name="g_DiffuseTex" type="texture"/>
				<var name="g_MaskTex" type="texture"/>
				<var name="g_TransU" type="float" default="0"/>
				<var name="g_TransV" type="float" default="0"/>
				<var name="g_ScaleU" type="float" default="1"/>
				<var name="g_ScaleV" type="float" default="1"/>
				<var name="g_RotUV" type="float" default="0"/>
			</Params>
			<Samplers>
				<sampler name="s_DiffuseSampler" texture="g_DiffuseTex"/>
				<sampler name="s_MaskSampler" texture="g_MaskTex"/>
			</Samplers>
		</Material>
		
		<Material name="particle">
			<Technique name="2DParticle" usage="135" lod="0" shader="particle_Main">
				<State name="CullMode" value="CullOff"/>
				<State name="ZTest" value="true"/>
				<State name="ZWrite" value="false"/>
				<State name="ColorMask" value="RGB"/>
			</Technique>
			<Technique name="3DParticle" usage="135" lod="0" shader="particle_Main">
				<State name="CullMode" value="CullOff"/>
				<State name="ZTest" value="true"/>
				<State name="ZWrite" value="true"/>
				<State name="ColorMask" value="RGB"/>
			</Technique>
			<Technique name="distort" usage="32" lod="0" shader="particle_Distort"/>
			<Params>
				<var name="g_DiffuseTex" type="texture"/>
				<var name="g_MaskTex" type="texture"/>
				<var name="g_fBlendMode" type="float"/>
			</Params>
			<Samplers>
				<sampler name="s_DiffuseSampler" texture="g_DiffuseTex" addressU="clamp" addressV="clamp" addressU1="wrap" addressV1="wrap"/>
				<sampler name="s_MaskSampler" texture="g_MaskTex"  addressU="clamp" addressV="clamp"  addressU1="wrap" addressV1="wrap"/>
			</Samplers>
		</Material>
		<!-- <Material name="particle_ext1">
			<Technique name="3DParticle" usage="135" lod="0" shader="particle_Main">
				<State name="CullMode" value="CullBack"/>
				<State name="ZTest" value="true"/>
				<State name="ZWrite" value="true"/>
				<State name="ColorMask" value="RGBA"/>
			</Technique>
			<Technique name="2DParticle" usage="135" lod="0" shader="particle_Main">
				<State name="CullMode" value="CullOff"/>
				<State name="ZTest" value="false"/>
				<State name="ZWrite" value="false"/>
				<State name="ColorMask" value="RGBA"/>
			</Technique>
			<Params>
				<var name="g_DiffuseTex" type="texture"/>
				<var name="g_MaskTex" type="texture"/>
				<var name="g_fBlendMode" type="float"/>
			</Params>
			<Samplers>
				<sampler name="s_DiffuseSampler" texture="g_DiffuseTex" addressU="clamp" addressV="clamp" addressU1="wrap" addressV1="wrap"/>
