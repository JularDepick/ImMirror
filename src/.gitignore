# 原生外置构建目录
native/build/

# 原生库二进制由 scripts/build-native.sh 生成, 只保留目录占位
android/app/src/main/jniLibs/**/*.so

# Gradle 与 Android 构建产物
android/.gradle/
android/build/
android/app/build/
android/.cxx/
android/captures/
android/.idea/
android/*.iml
android/local.properties

# 临时目录与日志
temp/
tmp/
*.log

# 由 scripts/build_atlas.py 生成的图集产物
android/app/src/main/assets/generated/

# 由 scripts/pack_assets.py 复制到安装包的资源子集
android/app/src/main/assets/sounds/
android/app/src/main/assets/ui/

# 由 scripts/gen_ui_resources.py 生成的界面参数表: Java 常量类与原生头文件
android/app/src/main/java/com/julardepick/immirror/generated/
native/ui/generated/

# 由 scripts/gen_atlas_ui.py 生成的界面图集: 裸 RGBA 数据与格位表
assets/ui/generated/

# 由 scripts/gen_block_data.py 生成的方块数据表: 中文名与掉落物
native/game/generated/

# 由 scripts/gen_monster_data.py 生成的生物数据表: 名称, 生命, 攻击, 尺寸与掉落
native/entity/generated/

# 由 scripts/gen_furnace_data.py 生成的熔炉配方与燃料表
# (与 native/game/generated/ 同目录, 规则已覆盖)

# 由 scripts/gen_block_light.py 生成的方块光照表
native/voxel/generated/

# 由 scripts/gen_biome_data.py 生成的群系带表
# (与 native/voxel/generated/ 同目录, 规则已覆盖)

# 由 scripts/gen_achievement_data.py 生成的成就与每日任务表
native/progress/generated/

# Python 缓存
__pycache__/
*.pyc
