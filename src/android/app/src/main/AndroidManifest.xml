<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 账号接口需要访问服务端; 联调期为明文 HTTP, 见 application 的 usesCleartextTraffic -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- 渲染后端要求 GLES 3.0; Vulkan 作为可选能力, 当前不强制 -->
    <uses-feature
        android:glEsVersion="0x00030000"
        android:required="true" />

    <application
        android:allowBackup="false"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.DeviceDefault.NoActionBar"
        android:usesCleartextTraffic="true">

        <!-- 入口界面: 已登录直接进入游戏, 未登录进入登录界面; 从游戏返回后作为账号与设备信息页 -->
        <activity
            android:name=".LauncherActivity"
            android:configChanges="orientation|screenLayout|screenSize|smallestScreenSize|density|fontScale|locale|layoutDirection"
            android:exported="true"
            android:label="@string/app_name"
            android:screenOrientation="sensorLandscape">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 登录界面: 登录, 注册与找回密码共用一页, 服务端地址可在此修改 -->
        <activity
            android:name=".account.LoginActivity"
            android:configChanges="orientation|screenLayout|screenSize|smallestScreenSize|density|fontScale|locale|layoutDirection"
            android:exported="false"
            android:label="@string/account_tab_login"
            android:screenOrientation="sensorLandscape"
            android:windowSoftInputMode="adjustResize" />

        <!-- 设置界面: 从账号面板进入, 键表与取值范围由原生设置层动态下发 -->
        <activity
            android:name=".settings.SettingsActivity"
            android:configChanges="orientation|screenLayout|screenSize|smallestScreenSize|density|fontScale|locale|layoutDirection"
            android:exported="false"
            android:label="@string/settings_title"
            android:screenOrientation="sensorLandscape" />

        <!-- 背包界面: 浏览物品, 整理堆叠与丢弃, 数据由原生物品系统下发 -->
        <activity
            android:name=".inventory.InventoryActivity"
            android:configChanges="orientation|screenLayout|screenSize|smallestScreenSize|density|fontScale|locale|layoutDirection"
            android:exported="false"
            android:label="@string/inventory_title"
            android:screenOrientation="sensorLandscape" />

        <!-- 编辑器界面: 体素工程编辑, 保存载入与试玩 -->
        <activity
            android:name=".editor.MapEditorActivity"
            android:configChanges="orientation|screenLayout|screenSize|smallestScreenSize|density|fontScale|locale|layoutDirection"
            android:exported="false"
            android:label="@string/editor_title"
            android:screenOrientation="sensorLandscape" />

        <!-- 成就界面: 成就列表与每日任务, 数据来自服务端 -->
        <activity
            android:name=".progress.ProgressActivity"
            android:configChanges="orientation|screenLayout|screenSize|smallestScreenSize|density|fontScale|locale|layoutDirection"
            android:exported="false"
            android:label="@string/progress_title"
            android:screenOrientation="sensorLandscape" />

        <!-- 游戏界面: NativeActivity, 主循环与输入全部在原生线程内完成 -->
        <activity
            android:name=".PlayActivity"
            android:configChanges="orientation|keyboardHidden|keyboard|navigation|screenLayout|screenSize|smallestScreenSize|uiMode|density|touchscreen|fontScale|locale|layoutDirection"
            android:exported="false"
            android:label="@string/app_name"
            android:screenOrientation="landscape"
            android:theme="@android:style/Theme.DeviceDefault.NoActionBar.Fullscreen">
            <meta-data
                android:name="android.app.lib_name"
                android:value="immirror_core" />
        </activity>
    </application>
</manifest>