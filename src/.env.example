# ImMirror 服务端配置样例
# 复制为 .env 后按需修改; 所有值都有内置缺省, 未设置也能启动

# 监听地址与端口
NITRO_HOST=0.0.0.0
NITRO_PORT=61110

# SQLite 数据库文件路径
DB_FILE=./data/immirror.db

# 会话与验证码策略
SESSION_TTL_DAYS=30
CODE_TTL_SECONDS=600
SEND_COOLDOWN_SECONDS=60
SEND_DAILY_LIMIT=10
VERIFY_MAX_ATTEMPTS=5
PASSWORD_MIN_LENGTH=8
BODY_LIMIT_BYTES=8192

# 限流阈值
LOGIN_MAX_FAILURES=5
RESET_HOURLY_LIMIT=5
SEND_HOURLY_IP_LIMIT=30
REQUEST_MINUTE_IP_LIMIT=120

# 邮件发送: smtp 使用真实 SMTP, memory 只把邮件留在内存 (测试用)
MAIL_TRANSPORT=smtp
MAIL_DEBUG_LOG=false
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# 协议版本信息
API_VERSION=v1
MIN_CLIENT_VERSION=0.1.0
